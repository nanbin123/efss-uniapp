.c-picker{position:relative;z-index:888}.c-picker .mask{position:fixed;z-index:1000;top:0;right:0;left:0;bottom:0;background:rgba(0,0,0,.6);visibility:hidden;opacity:0;transition:all .3s ease}.c-picker .mask.show{visibility:visible;opacity:1}.c-picker .c-picker-cnt{position:fixed;bottom:0;left:0;width:100%;transition:all .3s ease;transform:translateY(100%);z-index:3000}.c-picker .c-picker-cnt.show{transform:translateY(0)}.c-picker .c-picker-hd{display:flex;align-items:center;padding:0 15px;height:44px;background-color:#fff;position:relative;text-align:center;font-size:16px;justify-content:space-between}.c-picker .c-picker-hd .c-picker-btn{font-size:15px}.c-picker .c-picker-hd:after{content:" ";position:absolute;left:0;bottom:0;right:0;height:1px;border-bottom:1px solid #e5e5e5;color:#e5e5e5;transform-origin:0 100%;transform:scaleY(.5)}.c-picker .c-picker-item{text-align:center;width:100%;height:44px;line-height:44px;text-overflow:ellipsis;white-space:nowrap;font-size:15px}.c-picker .c-picker-view{width:100%;height:238px;overflow:hidden;background-color:#fff;z-index:666}.c-picker picker-view{height:100%}
