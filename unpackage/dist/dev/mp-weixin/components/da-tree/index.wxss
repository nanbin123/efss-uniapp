
@font-face {
  font-family: 'da-tree-iconfont'; /* Project id  */
  src: url('data:application/octet-stream;base64,') format('truetype');
}
.da-tree {
/*  width: 100%;
  height: 100%; */
}
.da-tree-scroll {
  width: 100%;
  height: 100%;
}
.da-tree-item {
  display: flex;
  align-items: center;
  height: 0;
  padding: 0;
  overflow: hidden;
  font-size: 15px;
  line-height: 1;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.2s linear;
}
.da-tree-item.is-show {
  height: auto;
  padding: 6px;
  visibility: visible;
  opacity: 1;
}
.da-tree-item__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 25px;
  overflow: hidden;
}
.da-tree-item__icon--arr {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 15px;
  height: 15px;
}
.da-tree-item__icon--arr::after {
  position: relative;
  z-index: 1;
  overflow: hidden;
  /* stylelint-disable-next-line font-family-no-missing-generic-family-keyword */
  font-family: 'da-tree-iconfont' !important;
  font-size: 18px;
  font-style: normal;
  color: #999;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.da-tree-item__icon--arr.is-expand::after {
  content: '\e604';
}
.da-tree-item__icon--arr.is-right {
  transform: rotate(-90deg);
}
.da-tree-item__icon--arr.is-loading {
  animation: IconLoading 1s linear 0s infinite;
}
.da-tree-item__icon--arr.is-loading::after {
  content: '\e7f1';
}
.da-tree-item__checkbox {
  width: 20px;
  height: 20px;
  overflow: hidden;
}
.da-tree-item__checkbox--left {
  order: 0;
}
.da-tree-item__checkbox--right {
  order: 1;
}
.da-tree-item__checkbox--icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
}
.da-tree-item__checkbox--icon::after {
  position: relative;
  top: 0;
  left: 0;
  z-index: 1;
  overflow: hidden;
  /* stylelint-disable-next-line font-family-no-missing-generic-family-keyword */
  font-family: 'da-tree-iconfont' !important;
  font-size: 17px;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.da-tree-item__checkbox--icon.da-tree-checkbox-outline::after {
  color: #bbb;
  content: '\ead5';
}
.da-tree-item__checkbox--icon.da-tree-checkbox-checked::after {
  color: var(--theme-color,#007aff);
  content: '\ead4';
}
.da-tree-item__checkbox--icon.da-tree-checkbox-indeterminate::after {
  color: var(--theme-color,#007aff);
  content: '\ebce';
}
.da-tree-item__checkbox--icon.da-tree-radio-outline::after {
  color: #bbb;
  content: '\ecc5';
}
.da-tree-item__checkbox--icon.da-tree-radio-checked::after {
  color: var(--theme-color,#007aff);
  content: '\ecc4';
}
.da-tree-item__checkbox--icon.da-tree-radio-indeterminate::after {
  color: var(--theme-color,#007aff);
  content: '\ea4f';
}
.da-tree-item__checkbox.is--disabled {
  cursor: not-allowed;
  opacity: 0.35;
}
.da-tree-item__label {
  flex: 1;
  margin-left: 2px;
  color: #555;
}
.da-tree-item__label--2 {
  color: var(--theme-color,#007aff);
}
.da-tree-item__label--append {
  font-size: 60%;
  opacity: 0.6;
}


