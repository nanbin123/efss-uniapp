.head.data-v-7f77e776{
	height: 5px;
	width: 100%;
	background-color:  #efeef3ff;
}
.item.data-v-7f77e776{
	display: flex;	
	padding: 8px 0 8px 8px;
	border-bottom: 1px solid #f1f1f1ff;	
	align-items: center;
	background-color: #fff;
}
.item .title.data-v-7f77e776{
	flex-shrink: 0;
	font-size: 15px;
	color: #333;
	white-space: nowrap;
	text-rendering: optimizeLegibility;
}
.item .iconfont.data-v-7f77e776{
	color: red;	
	font-size: 12px;
	margin-left: -5px;
}
.item input.data-v-7f77e776{
	flex-grow: 1;
	padding-right: 12px;
	text-align: right;	
	text-rendering: optimizeLegibility;
}
.item .input-placeholder.data-v-7f77e776{
	font-size: 15px;
	text-align: right;
	color: #aaa;
	text-rendering: optimizeLegibility;
}

/* 客户性别 */
.gender.data-v-7f77e776{
	margin-left: auto;
	padding-right: 15px;
}
.data-v-7f77e776 .gender .radio-group svg {
	display: none  !important;
}
.data-v-7f77e776 .gender .uni-radio-input {
	border-radius: 0 !important;
	width: 50px !important;
	height: 25px !important;
	margin-right:0 !important;
	border-color: #38c1b9 !important;
}
.data-v-7f77e776 .gender .radio-group .radio1,.radio2.data-v-7f77e776{
	position: relative !important;
}
.data-v-7f77e776 .gender .radio-group .radio1 .uni-radio-input {	
	border-right: 0 !important;
	border-top-left-radius: 8% !important;
	border-bottom-left-radius:8% !important;
}
.data-v-7f77e776 .gender .radio-group .radio2  .uni-radio-input {	
	border-top-right-radius: 8% !important;
	border-bottom-right-radius:8% !important;
}
.radio-text.data-v-7f77e776{
	position: absolute;
	left: 20px;
	top: 2px;
	font-size: 12px;	
	line-height: 25px;
}
/*适用于 微信小程序*/
.data-v-7f77e776 .gender .wx-radio-input {
	border-radius: 0 !important;
	width: 50px !important;
	height: 25px !important;
	margin-right:0 !important;
	border-color: #38c1b9 !important;
}
.data-v-7f77e776 .gender .radio-group .radio1 .wx-radio-input {	
	border-right: 0 !important;
	border-top-left-radius: 8% !important;
	border-bottom-left-radius:8% !important;
}
.data-v-7f77e776 .gender .radio-group .radio2  .wx-radio-input {	
	border-top-right-radius: 8% !important;
	border-bottom-right-radius:8% !important;
}
.data-v-7f77e776 .gender .wx-radio-input.wx-radio-input-checked::before{
 font-size:0; /* 对勾大小 */
}
.starLen.data-v-7f77e776{
	display: flex;
	margin-left: auto;
}
.star.data-v-7f77e776{
	width: 17px;
	height: 17px;
	padding: 0 17px;
}
.product-count.data-v-7f77e776{
	display: flex;
	justify-content: space-between;
	font-size: 15px;
	padding: 10px 20px;
	border-bottom: 2px solid #efeef3ff;
	margin-bottom: 5px;
}
.product.data-v-7f77e776{
	display: flex;
	align-items: stretch;
	background-color: #fff;
	border-bottom: 1px solid #e5e5e5;
	box-sizing: border-box;
}
.product-content.data-v-7f77e776{
	flex: 1;
	min-width: 0;
	padding: 8px 0 8px 8px;
	box-sizing: border-box;
}
.grid.data-v-7f77e776 {	
 	display: flex;
	align-items: center;
	min-height: 24px;
	line-height: 20px;
}
.info.data-v-7f77e776 {
  width: 50%;
	min-width: 0;
  font-size: 14px;
  color: #333;
  white-space: nowrap;
  overflow: hidden; /* 超出部分隐藏 */
  text-overflow: ellipsis; /* 显示省略号 */
  text-rendering: optimizeLegibility;
}
.product-emphasis.data-v-7f77e776{
	color: #e96225ff;
}
.product-actions.data-v-7f77e776{
	width: 64px;
	flex-shrink: 0;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
	padding: 7px 4px;
	box-sizing: border-box;
}
.product-action.data-v-7f77e776{
	width: 48px;
	min-height: 44px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	color: #38c1b9;
}
.product-remove .iconfont.data-v-7f77e776{
	color: #38c1b9;
	font-size: 22px;
	line-height: 24px;
}
.product-action-label.data-v-7f77e776{
	margin-top: 2px;
	font-size: 11px;
	line-height: 14px;
	color: #38c1b9;
}
.gallery-icon.data-v-7f77e776{
	position: relative;
	width: 24px;
	height: 21px;
	border: 1.5px solid #38c1b9;
	border-radius: 3px;
	box-sizing: border-box;
}
.gallery-dot.data-v-7f77e776{
	position: absolute;
	top: 4px;
	left: 5px;
	width: 3px;
	height: 3px;
	border-radius: 50%;
	background-color: #38c1b9;
}
.gallery-mountain.data-v-7f77e776{
	position: absolute;
	bottom: 3px;
	width: 8px;
	height: 8px;
	border-left: 1.5px solid #38c1b9;
	border-top: 1.5px solid #38c1b9;
	transform: rotate(45deg);
	box-sizing: border-box;
}
.gallery-mountain-left.data-v-7f77e776{
	left: 4px;
}
.gallery-mountain-right.data-v-7f77e776{
	right: 3px;
	width: 7px;
	height: 7px;
}
.gallery-count.data-v-7f77e776{
	position: absolute;
	top: -7px;
	right: -8px;
	min-width: 14px;
	height: 14px;
	padding: 0 3px;
	border-radius: 7px;
	box-sizing: border-box;
	background-color: #38c1b9;
	color: #fff;
	font-size: 9px;
	line-height: 14px;
	text-align: center;
}

/* 微信小程序窄屏：保持操作区可点击，同时尽量给产品信息留出宽度 */
@media screen and (max-width: 375px) {
.product-content.data-v-7f77e776{
		padding-left: 6px;
}
.product-actions.data-v-7f77e776{
		width: 58px;
		padding-left: 2px;
		padding-right: 2px;
}
.info.data-v-7f77e776{
		font-size: 13px;
}
}
.add_img.data-v-7f77e776 {
	position: relative;
    border: 1px solid #CCCCCC;    
    width: 40px;
	height: 40px;
	text-align: center;
	margin-left: auto;
	margin-right: 20px;
}
.add_img image.data-v-7f77e776 {
    width: 35px;
    height: 35px;
	margin-top: 3px;
}
.footer.data-v-7f77e776{
	height: 30px;
	font-size: 15px;
	text-align: center;
	line-height: 30px;
	background-color: #38c1b9;	
	color: #daf2fbff;
	width: 100%;
}