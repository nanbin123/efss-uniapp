.head.data-v-9d2bcbee {
		border-top: 5px solid #efeef3;
		border-bottom: 1px solid #edf0f4;
		width: 100%;
}
.screen-bar.data-v-9d2bcbee {
		position: relative;
		display: flex;
		align-items: center;
		padding: 8px 16rpx;
		background-color: #fff;
		box-sizing: border-box;
}
.screen-bar-item.data-v-9d2bcbee {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex: 0 0 156rpx;
		height: 34px;
		padding: 0 18rpx;
		box-sizing: border-box;
		border-radius: 8px;
		background-color: #eaf8ff;
		color: #00a7e2;
}
.bar-item-text.data-v-9d2bcbee {
		font-size: 28rpx;
		font-weight: 500;
		white-space: nowrap;
}
.filter-chevron.data-v-9d2bcbee {
		width: 6px;
		height: 6px;
		flex-shrink: 0;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: translateY(-2px) rotate(45deg);
		transition: transform .2s;
}
.filter-chevron.is-open.data-v-9d2bcbee {
		transform: translateY(2px) rotate(225deg);
}
.datestartAndEnd.data-v-9d2bcbee {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		margin-left: 12rpx;
}
.dateStart.data-v-9d2bcbee, .dateEnd.data-v-9d2bcbee {
		flex: 1;
		min-width: 0;
		border-left: 1px solid #edf0f4;
}
.date-trigger.data-v-9d2bcbee {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 34px;
		padding: 0 4rpx;
		white-space: nowrap;
		color: #747d89;
}
.date-placeholder.data-v-9d2bcbee {
		font-size: 30rpx;
}
.date-value.data-v-9d2bcbee {
		font-size: 30rpx;
		color: #333;
}
.date-chevron.data-v-9d2bcbee {
		width: 5px;
		height: 5px;
		margin-left: 6rpx;
}
.reset-button.data-v-9d2bcbee {
		flex-shrink: 0;
		margin: 0 0 0 10rpx;
		padding: 0 12rpx;
		font-size: 24rpx;
		line-height: 24px;
		color: #00a7e2;
		background-color: #fff;
		border: 1px solid #00a7e2;
		border-radius: 5px;
}
.reset-button.data-v-9d2bcbee::after {
		border: none;
}
.dropdown-box.data-v-9d2bcbee {
		position: absolute;
		left: 16rpx;
		top: calc(100% - 4px);
		width: 220rpx;
		padding: 4px 0;
		box-sizing: border-box;
		background-color: #fff;
		border: 1px solid #e2e8ef;
		border-radius: 10px;
		box-shadow: 0 5px 16px rgba(30, 60, 80, .12);
		z-index: 99;
		overflow: hidden;
}
.dropdown-item.data-v-9d2bcbee {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 40px;
		padding: 0 24rpx;
		font-size: 28rpx;
		color: #333;
}
.dropdown-item.is-selected.data-v-9d2bcbee {
		background-color: #eaf8ff;
		color: #00a7e2;
}
.selected-check.data-v-9d2bcbee {
		width: 6px;
		height: 11px;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-2px) rotate(45deg);
}
.bg-mask.data-v-9d2bcbee {		
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: transparent;
		z-index: 98;
		transition: all 0.3s ease-in-out;
		opacity: 0;
		visibility: hidden;
}
.bg-mask-show.data-v-9d2bcbee {
		visibility: visible;
		opacity: 0.8;
}
.product.data-v-9d2bcbee{ 		
		position: relative;
		display: flex;
		align-items: center;
		background-color: #fff; 
		border-bottom: 1px solid #cbcbcbff;
		padding: 8px 5px 8px 10px;
}
.product .product-content.data-v-9d2bcbee {
	   flex: 1;
	   min-width: 0;
}
.product .product-content .item.data-v-9d2bcbee {
	 	display: flex;
	 	line-height: 14px;
	 	padding-bottom: 3px;
}
.product .product-content .info.data-v-9d2bcbee {
	  width: 50%;
	  color: #030303ff;
	  font-size: 14px;
	  color: #333;
	  white-space: nowrap;  
	  overflow: hidden; /* 超出部分隐藏 */
