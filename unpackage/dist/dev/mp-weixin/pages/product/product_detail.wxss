	text-rendering: optimizeLegibility;
}
.item .iconfont.data-v-0591f1f7{
	color: red;	
	font-size: 12px;
	margin-left: -5px;
}
.item input.data-v-0591f1f7{
	flex-grow: 1;
	padding-right: 12px;
	text-align: right;
	margin-left: 20px;
	text-rendering: optimizeLegibility;
	font-size: 15px;
	color: #333;
}
.product_texture.data-v-0591f1f7{
	border-bottom: 5px solid #efeef4ff;
}
.item .input-placeholder.data-v-0591f1f7{
	font-size: 15px;
	text-align: right;
	color: #aaa;
	text-rendering: optimizeLegibility;
}
.item .type.data-v-0591f1f7{
	padding-right:30px;	
	background-repeat: no-repeat;
	background-position: 99%;
	 background-size: 10px 15px;
}
.product-image.data-v-0591f1f7{
	padding: 7px;
}
.proeuct-item-img.data-v-0591f1f7{
	display: block;
	width: 100%;
	height: 100px;
}
.product-title.data-v-0591f1f7{
	font-size: 18px;
