
.head.data-v-0591f1f7{
	height: 5px;
	width: 100%;
	background-color:  #efeef3ff;
	position: fixed;
	z-index: 999;
}
.item.data-v-0591f1f7{
	display: flex;	
	padding: 8px 0;
	border-bottom: 1px solid #f1f1f1ff;	
	align-items: center;
	background-color: #fff;
}
.item .title.data-v-0591f1f7{
	margin-left: 8px;
	font-size: 15px;
	color: #333;
