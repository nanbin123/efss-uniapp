	display: flex;
	flex-wrap: wrap;
}
.product-image-add.data-v-0591f1f7{
	width: 80px;
	height: 80px;
	margin-top: 23px;
	margin-left: 20px;
}
.product-image-item.data-v-0591f1f7{
	position: relative;
	margin-top: 15px;
	margin-right:15px;
	flex: 0 calc(33.3% - 15px);
}
