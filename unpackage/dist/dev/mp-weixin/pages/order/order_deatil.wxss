	min-height: 24px;
	line-height: 20px;
}
.info.data-v-c7fdb702 {
  width: 50%;
	min-width: 0;
  font-size: 14px;
  color: #333;
  white-space: nowrap;  
  overflow: hidden; /* 超出部分隐藏 */
  text-overflow: ellipsis; /* 显示省略号 */
  text-rendering: optimizeLegibility;
}
.product-emphasis.data-v-c7fdb702{
	color: #e96225ff;
}
.product-actions.data-v-c7fdb702{
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: 1;
	width: 64px;
	pointer-events: none;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
	padding: 7px 4px;
	box-sizing: border-box;
}
.product-action.data-v-c7fdb702{
	pointer-events: auto;
	width: 48px;
	min-height: 44px;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	color: #00a7e2ff;
}
.product-remove .iconfont.data-v-c7fdb702{
	color: #00a7e2ff;
	font-size: 22px;
	line-height: 24px;
}
.product-action-label.data-v-c7fdb702{
	margin-top: 2px;
	font-size: 11px;
	line-height: 14px;
	color: #00a7e2ff;
}
.gallery-icon.data-v-c7fdb702{
	position: relative;
	width: 24px;
	height: 21px;
	border: 1.5px solid #00a7e2ff;
	border-radius: 3px;
	box-sizing: border-box;
}
.gallery-dot.data-v-c7fdb702{
	position: absolute;
	top: 4px;
	left: 5px;
	width: 3px;
	height: 3px;
	border-radius: 50%;
	background-color: #00a7e2ff;
}
.gallery-mountain.data-v-c7fdb702{
	position: absolute;
	bottom: 3px;
	width: 8px;
	height: 8px;
	border-left: 1.5px solid #00a7e2ff;
	border-top: 1.5px solid #00a7e2ff;
	transform: rotate(45deg);
	box-sizing: border-box;
}
.gallery-mountain-left.data-v-c7fdb702{
	left: 4px;
}
.gallery-mountain-right.data-v-c7fdb702{
	right: 3px;
	width: 7px;
	height: 7px;
}
.gallery-count.data-v-c7fdb702{
	position: absolute;
	top: -7px;
	right: -8px;
	min-width: 14px;
	height: 14px;
	padding: 0 3px;
	border-radius: 7px;
	box-sizing: border-box;
	background-color: #00a7e2ff;
	color: #fff;
	font-size: 9px;
	line-height: 14px;
	text-align: center;
}

