/* 客户性别 */
.gender.data-v-104119aa{
	margin-left: auto;
	padding-right: 15px;
}
.data-v-104119aa .gender .radio-group svg {
	display: none  !important;
}
.data-v-104119aa .gender .uni-radio-input {
	border-radius: 0 !important;
	width: 50px !important;
	height: 25px !important;
	margin-right:0 !important;
	border-color: #00a7e2ff;
}
.gender .radio-group .radio1.data-v-104119aa,.radio2.data-v-104119aa{
	position: relative !important;
}
.data-v-104119aa .gender .radio-group .radio1 .uni-radio-input {	
	border-right: 0 !important;
	border-top-left-radius: 8% !important;
	border-bottom-left-radius:8% !important;
}
.data-v-104119aa .gender .radio-group .radio2  .uni-radio-input {	
	border-top-right-radius: 8% !important;
	border-bottom-right-radius:8% !important;
}
.radio-text.data-v-104119aa{
	position: absolute;
	left: 20px;
	top: 2px;
	font-size: 12px;	
	line-height: 25px;
}
/*适用于 微信小程序*/
.data-v-104119aa .gender .wx-radio-input {
	border-radius: 0 !important;
