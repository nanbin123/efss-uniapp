}
.data-v-104119aa .gender .radio-group .radio1 .wx-radio-input {	
	border-right: 0 !important;
	border-top-left-radius: 8% !important;
	border-bottom-left-radius:8% !important;
}
.data-v-104119aa .gender .radio-group .radio2  .wx-radio-input {	
