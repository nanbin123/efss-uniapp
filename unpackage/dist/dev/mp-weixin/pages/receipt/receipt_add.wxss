	height: 100px;
}
.voucher-remove.data-v-5d9c084a{
	background-color: #D1372C;
	color: #fff;
	width: 24px;
	height: 24px;
	display: flex;
	justify-content: center;
	align-items: flex-start;
	opacity: 0.8;
	position: absolute;
	z-index: 2;
	cursor: pointer;
	box-sizing: border-box;
	top: 0;
	right: 0;
	border-radius: 0 0 0 100%;
}
.voucher-remove text.data-v-5d9c084a{
	transform: scale(0.8);
	position: absolute;
	right: 3px;
}
