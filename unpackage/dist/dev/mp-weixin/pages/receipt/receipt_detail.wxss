
.head.data-v-9b0cb02d{
	height: 5px;
	width: 100%;
	background-color:  #efeef3ff;
	position: fixed;
	z-index: 999;
}
.item.data-v-9b0cb02d{	
	display: flex;	
	padding: 8px 0;
	border-bottom: 1px solid #efeef3ff;
	align-items: center;
	background-color: #fff;
}
.item .img.data-v-9b0cb02d{
	margin-left: 2px;
	width: 20px;
	height: 20px;
}
.item .title.data-v-9b0cb02d{
	margin-left: 3px;
	font-size: 15px;
	color: #333;
	white-space: nowrap; /* 文字不换行 */
	text-rendering: optimizeLegibility;
}
.item .right-content.data-v-9b0cb02d{
	flex-grow: 1;
	padding-right: 12px;
	text-align: right;
	margin-left: 20px;
	text-rendering: optimizeLegibility;
	font-size: 15px;
	color: #333;
}
.item input.data-v-9b0cb02d {
	flex-grow: 1;
	padding-right: 12px;
	text-align: right;
	margin-left: 20px;
	text-rendering: optimizeLegibility;
	font-size: 15px;
	color: #333;
}
.item .input-placeholder.data-v-9b0cb02d{
	font-size: 16px;
	text-align: right;
	color: #aaa;
}
.voucher.data-v-9b0cb02d{
	padding: 7px 0 0 15px;
}
.voucher-title.data-v-9b0cb02d{
	font-size: 18px;
	font-weight: 600;
}
.voucher-img.data-v-9b0cb02d{
	display: flex;
	flex-wrap: wrap;
}
.voucher-add.data-v-9b0cb02d{
	width: 80px;
	height: 80px;
	margin-top: 20px;
	margin-left: 20px;
}
.voucher-item.data-v-9b0cb02d{	
	position: relative;
	margin-top: 15px;
	margin-right:15px;
	flex: 0 calc(33.3% - 15px);
}
.voucher-item-img.data-v-9b0cb02d{
	display: block;
	width: 100%;
	height: 100px;
}
.voucher-remove.data-v-9b0cb02d{
	background-color: #D1372C;
	color: #fff;
	width: 24px;
	height: 24px;
	display: flex;
	justify-content: center;
	align-items: flex-start;
	opacity: 0.8;
	position: absolute;
	z-index: 2;
	cursor: pointer;
	box-sizing: border-box;
	top: 0;
	right: 0;
	border-radius: 0 0 0 100%;
}
.voucher-remove text.data-v-9b0cb02d{
	transform: scale(0.8);
	position: absolute;
	right: 3px;
}
.textarea-placeholder.data-v-9b0cb02d{
	font-size: 15px;
}
.remarks.data-v-9b0cb02d{
	overflow: hidden;
	position: relative;	
	border-bottom: 1px solid #f1f1f1ff;	
	padding: 10px;
}
.remarks textarea.data-v-9b0cb02d {
	height: 60px;	
	width: 100%;	
	font-size: 15px;
	color: #333;
}
.textarea-count.data-v-9b0cb02d {
	position: absolute;
	font-size: 12px;
	line-height: 16px;
	bottom: 5px;
	right: 0px;
	color: #999;
}
.bottom-bar.data-v-9b0cb02d {  
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 39px;
  background-color: #fff;
  border-top: 1px solid #cbcbcbff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.delete.data-v-9b0cb02d {
  width:50%;
